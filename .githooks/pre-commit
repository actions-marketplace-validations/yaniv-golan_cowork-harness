#!/usr/bin/env bash
#
# Block committing prettier-unformatted TypeScript.
#
# Checks ONLY the staged src/ and test/ .ts files against .prettierrc.json, so it
# never trips on pre-existing formatting debt in files you did not touch. This is
# the local guard for the same rule CI enforces (`npm run format:check`), which
# otherwise only runs on a pushed branch.
#
# Bypass (not recommended): git commit --no-verify
#
set -euo pipefail

# Staged (Added/Copied/Modified/Renamed) TypeScript under src/ or test/.
#
# NOTE: do NOT `exit 0` here when there are no staged .ts files. The baseline→cassette check
# below must run for EVERY commit that stages a baseline — and a parity-sync commit stages a
# baseline and NOTHING ELSE (no src/test .ts). An early exit here let exactly those commits — the
# ones most likely to move `latest` and stale the cassettes — bypass the guard entirely (the
# staleness then surfaced a commit later, on the next commit that happened to touch a .ts file, or
# on the release PR's first CI run). So the prettier block is now CONDITIONAL on there being .ts
# files, and control always falls through to the baseline check.
files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(src|test)/.*\.ts$' || true)

if [ -n "$files" ]; then
  # Degrade gracefully if deps aren't installed yet (e.g. fresh clone pre-`npm install`).
  if ! npx --no-install prettier --version >/dev/null 2>&1; then
    echo "⚠ pre-commit: prettier not installed (run 'npm install') — skipping format check."
  # prettier honors .prettierrc.json + .prettierignore; --check lists unformatted files.
  # shellcheck disable=SC2086
  elif ! npx --no-install prettier --check $files; then
    echo ""
    echo "✖ pre-commit: the staged TypeScript above is not prettier-formatted."
    echo "  Fix these:  npx prettier --write $files"
    echo "  Or all:     npm run format:write"
    echo "  Then re-stage and commit. (Bypass with 'git commit --no-verify' if you must.)"
    exit 1
  fi
fi

#
# Block committing a new/moved baseline (baselines/desktop-*.json) without re-stamping or
# re-recording the committed example cassettes against it first.
#
# `latest` resolves to the newest baselines/desktop-*.json by version (src/baseline.ts,
# latestBaselineFile) — so ANY staged baseline file can move `latest` and instantly stale every
# example cassette's embedded fingerprint.baseline. This has bitten three separate release cycles
# (3431e09, 9eaba8d, and the 0.29.0 cycle) — always caught late, on the release PR's first-ever CI
# run, because these commits accumulate locally for a while before ever being pushed through a
# branch that triggers CI. This is the local guard for the same check CI runs
# (`verify-cassettes examples/replays/` in .github/workflows/ci.yml), so it fires at commit time
# instead of at release time.
#
# ALSO trigger on a staged cassette, not just a staged baseline. A baseline moves `latest` and stales the
# committed fixtures — that's why this started here — but the commit that ADDS or re-records a cassette is
# the one that can introduce a host-inventory leak, and it stages no baseline at all, so it used to skip
# this check entirely (the host-inventory warning below was unreachable on exactly that commit).
#
# The trigger is CONTENT-derived, not name-derived. `record --out` takes an arbitrary path and does NOT
# validate the suffix, so `--out notes/run.json` produces a real recording — with a real host inventory in
# it — that a `*.cassette.json` regex cannot see. Any staged `.json` whose STAGED BLOB (`git show :path`,
# not the worktree copy, which may differ from what is being committed) carries the generator marker is
# treated as a cassette. The name-based arm stays for baselines and for a cassette too large to scan twice.
baseline_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(baselines/desktop-.*|.*\.cassette)\.json$' || true)
recorded_json=$(
  git diff --cached --name-only --diff-filter=ACMR | grep -E '\.json$' | while read -r f; do
    [ -n "$f" ] || continue
    case "$f" in *.cassette.json|baselines/desktop-*.json) continue ;; esac
    if git show ":$f" 2>/dev/null | grep -q '"generator": *"cowork-harness"'; then echo "$f"; fi
  # `|| true` is LOAD-BEARING and binds to the whole pipeline, not just the loop. Under `set -euo
  # pipefail` a `grep` that matches nothing exits 1, pipefail lifts that out of the command substitution,
  # and the assignment then kills the hook — so without this, EVERY commit staging no `.json` (i.e. almost
  # all of them) died with no output at all. Pinned by 'the hook must not abort on the ordinary paths'.
  done || true
)
if [ -n "$recorded_json" ]; then
  baseline_files=$(printf '%s\n%s' "$baseline_files" "$recorded_json" | grep -v '^$' || true)
fi
if [ -n "$baseline_files" ]; then
  if [ ! -f dist/cli.js ]; then
    # FAIL CLOSED. This used to echo a warning and fall through, so the guard was OFF in exactly the states
    # easiest to be in: a fresh clone, after `git clean -xdf`, after a branch switch, and — because
    # `npm run build` does `rm -rf dist` FIRST — any time a typecheck is failing mid-refactor. A guard that
    # stops guarding without saying so is worse than none: the warning scrolls past and the commit succeeds.
    echo "✖ pre-commit: dist/cli.js not built, so staged cassettes cannot be verified."
    echo "  Run 'npm run build' and re-commit. (Bypass with 'git commit --no-verify' if you must.)"
    exit 1
  else
    # Verify the example dir (a staged BASELINE stales those) PLUS any staged cassette that lives elsewhere.
    # Exclude only files DIRECTLY in examples/replays/ — the directory invocation above covers exactly
    # those. `resolveInputs` does not recurse, so `examples/replays/sub/x.cassette.json` is invisible to it;
    # a blanket `grep -v '^examples/replays/'` here meant such a file was seen by NEITHER check. (Not
    # hypothetical: `isRepoVisiblePath`'s own docstring uses that path as its worked example.)
    staged_cassettes=$(printf '%s\n' "$baseline_files" | grep -vE '^baselines/desktop-' |
      grep -vE '^examples/replays/[^/]+$' || true)

    # ALLOWLIST, not a denylist. This used to test `= 1` (block) and `= 3` (warn) and let EVERYTHING else
    # through, so the guard silently switched itself off on any other exit. Two are ordinary refactors:
    #   exit 2   — examples/replays/ renamed or emptied, or any CLI flag renamed
    #   exit 127 — node not on PATH
    # Neither fails a test anywhere. Now anything that is not a proven clean 0 blocks; exit 3 is the one
    # exception, narrowed by CAUSE below.
    #
    # No --allow-* flags: the fixtures verify clean without them (CI runs this bare and passes), and
    # carrying suppressions here made the local gate LAXER than the CI gate it exists to pre-empt.
    tmp=$(mktemp -t cwh-verify-cassettes) || exit 1
    hook_status=0
    node dist/cli.js verify-cassettes examples/replays/ >"$tmp" 2>&1 || hook_status=$?
    for c in $staged_cassettes; do
      [ -f "$c" ] || continue
      s=0
      node dist/cli.js verify-cassettes "$c" >>"$tmp" 2>&1 || s=$?
      if [ "$s" != "0" ] && { [ "$hook_status" = "0" ] || [ "$s" = "1" ]; }; then hook_status=$s; fi
    done

    # Exit 3 folds three things together: unverifiable STALENESS, an unsupported cassetteVersion, and a
    # per-file read error. Only the first means "we looked and could not conclude". The other two mean the
    # privacy scan NEVER RAN — no evidence either way about host inventory — and waving those through
    # inverts this repo's own `can't verify ⇒ not green` doctrine on the one gate that runs before a push.
    if [ "$hook_status" = "3" ]; then
      # Read the CAUSE out of the JSON envelope. Two things make this fiddly, both learned the hard way:
      #
      #  1. `verify-cassettes --output-format json` EXITS 3 here by construction — that is why we are in
      #     this branch. So the JSON must be captured with `|| true`, or `set -e`/`pipefail` aborts the
      #     hook. Piping it straight into the probe and appending `|| echo true` produced the string
      #     "truetrue" (the probe's own answer, plus the fallback fired by the pipeline's exit 3), which
      #     then failed an `= "true"` comparison and waved an UNSCANNABLE cassette through as staleness.
      #  2. The polarity is therefore fail-CLOSED: only an explicit "false" clears the file. Empty output,
      #     a doubled string, or anything unexpected blocks. A guard whose safe answer depends on an exact
      #     string match is one typo away from the fail-open it exists to prevent.
      unscanned=false
      for c in examples/replays/ $staged_cassettes; do
        [ -e "$c" ] || continue
        probe_json=$(node dist/cli.js verify-cassettes "$c" --output-format json 2>/dev/null || true)
        u=$(printf '%s' "$probe_json" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const j=JSON.parse(s);if(!j||!Array.isArray(j.results))throw 0;process.stdout.write(String(j.results.some(r=>r.error||((r.version||[]).length>0))))}catch(e){process.stdout.write("true")}})' 2>/dev/null || true)
        if [ "$u" != "false" ]; then unscanned=true; fi
      done
      if [ "$unscanned" = "true" ]; then
        cat "$tmp"; rm -f "$tmp"
        echo ""
        echo "✖ pre-commit: a staged cassette could NOT BE SCANNED (unreadable, or a cassetteVersion this"
        echo "  build does not support), so the privacy scan never ran — nothing has checked it for a"
        echo "  [host-inventory] leak. 'Could not verify' is not 'verified clean'."
        echo "  Fix the cassette, or rebuild against the CLI that recorded it, then re-stage."
        echo "  (Bypass with 'git commit --no-verify' if you must.)"
        exit 1
      fi
      echo "⚠ pre-commit: unverifiable STALENESS on a staged cassette (exit 3 — not a privacy finding):"
      hook_status=0
    fi

    if [ "$hook_status" != "0" ]; then
      cat "$tmp"
      rm -f "$tmp"
      echo ""
      echo "✖ pre-commit: cassette verification did not pass cleanly (exit $hook_status)."
      echo "  A [host-inventory] finding means the recording carries THIS machine's MCP servers/agents/"
      echo "  account metadata; committing it publishes them. Re-record at 'container' tier (sealed)."
      echo "  A [stale] finding after a baseline change:"
      echo "  Re-stamp fingerprint.baseline in examples/replays/*.cassette.json to the new version"
      echo "  (safe when the spawn contract is unchanged — see 9eaba8d for precedent), or re-record"
      echo "  for real: cowork-harness record <scenario> --out examples/replays/<name>.cassette.json"
      echo "  (needs Docker + a live token — and DO NOT run this from an ambient dev session with"
      echo "  its own MCP servers/skills configured, at protocol/hostloop tier that inherits the host"
      echo "  environment: it bakes your personal tool/skill/MCP list into the committed fixture)."
      echo "  An exit 2 usually means this hook's own target moved (examples/replays/ renamed, or a CLI"
      echo "  flag renamed) — fix the hook rather than bypassing it."
      echo "  Then re-stage and commit. (Bypass with 'git commit --no-verify' if you must.)"
      exit 1
    fi
    cat "$tmp"
    rm -f "$tmp"
    echo "✓ pre-commit: cassette privacy + staleness scan passed."
  fi
fi
